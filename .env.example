# Copy to .env.local (gitignored) to point the creator at a real bucket.
#
# The endpoint must implement:
#   GET <endpoint>?op=<get|put|delete>&key=<url-encoded-key>
#   200 -> { "url": "<presigned-https-url>" }
#
# It is responsible for authorising the caller and for rejecting keys outside
# the performances/ prefix. No credential is held on the client, so anything
# the endpoint permits is permitted to the whole internet.
VITE_PRESIGN_ENDPOINT=

# For the deployed site this is set as a GitHub Actions repository *variable*
# of the same name (Settings -> Secrets and variables -> Actions -> Variables),
# read by .github/workflows/deploy.yml. Vite inlines it into the bundle, so it
# is public either way -- a secret would only hide it from the Actions log.
#
# You can also override it per-visit without rebuilding:
#   /performance_creator?persistence.presignEndpoint=https://...
